# Kopiraj u .env.local i popuni iz Supabase dashboarda
# (Project Settings → API Keys → publishable ključ)

NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tvoj-kljuc

# Kanonski URL sajta (za SEO: sitemap, OG, canonical)
NEXT_PUBLIC_SITE_URL=https://kolabo.rs

# Podaci o pružaocu usluge (Zakon o elektronskoj trgovini, čl. 6)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_MB=
NEXT_PUBLIC_LEGAL_PIB=
NEXT_PUBLIC_CONTACT_EMAIL=hello@kolabo.rs
